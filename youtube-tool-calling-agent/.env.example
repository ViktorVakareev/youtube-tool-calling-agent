# Which model the CLI, examples and notebook use: gemini | openai | offline
LLM_PROVIDER=gemini
# Where video data comes from: live (real YouTube, needs ".[youtube]") | sample (bundled made-up videos)
VIDEO_SOURCE=live

# Google Gemini - free API key from https://aistudio.google.com (no billing needed for the free tier)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional, billed per token)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
